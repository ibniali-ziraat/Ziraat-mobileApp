{
  "expo": {
    "name": "Ziraat",
    "slug": "ziraat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ziraaticon.png",
    "scheme": "ziraat",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "jsEngine": "hermes",
    "ios": {
      "buildNumber": "24",
      "supportsTablet": true,
      "bundleIdentifier": "com.alilals.ziraat",
      "jsEngine": "hermes",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 25,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/adaptiveicon.png",
        "softwareKeyboardLayoutMode": "pan"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.alilals.ziraat",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splashicon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-maps",
      [
        "./plugins/withNotificationIcon",
        {
          "iconDir": "assets/images/notification-icon",
          "color": "#2d6b06"
        }
      ],
      "./plugins/withQuietLibraryWarnings"
    ],
    "extra": {
      "router": {}
    }
  }
}
